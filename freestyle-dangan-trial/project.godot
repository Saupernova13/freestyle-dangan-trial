; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="freestyle-dangan-trial"
run/main_scene="uid://cf6h777ockpp2"
config/features=PackedStringArray("4.5", "Mobile")
run/max_fps=1000
config/icon="res://icon.svg"

[autoload]

TrialLoader="*res://scripts/core/TrialLoader.gd"
ScriptDirector="*res://scripts/core/ScriptDirector.gd"
AudioManager="*res://scripts/core/AudioManager.gd"
InputManager="*res://scripts/core/InputManager.gd"
InfluenceGauge="*res://scripts/core/InfluenceGauge.gd"
TruthBulletManager="*res://scripts/core/TruthBulletManager.gd"
CameraDirector="*res://scripts/camera/CameraDirector.gd"
ScreenEffects="*res://scripts/core/ScreenEffectsManager.gd"
Settings="*res://scripts/core/Settings.gd"
ConcentrateGauge="*res://scripts/core/ConcentrateGauge.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="freestyle-dangan-trial"

[importer_defaults]

import_gif_to_animated_texture={}

[input]

debate_slow_time={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194325,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
