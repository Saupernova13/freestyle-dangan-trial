{
  "name": "dangan-trial-editor",
  "version": "1.0.0",
  "description": "Browser-based authoring tool for custom Danganronpa-style trials",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "lint": "eslint js",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" index.html",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\" index.html",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
